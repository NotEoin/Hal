#!/usr/bin/env bash
# Runs the llama.cpp router that serves the models of one mode (see packages/hal-gateway/src/halgateway/modes/*.ini).
#
#   hal-serve start <mode>   start a mode from the preset directory, or reuse it if already serving
#   hal-serve stop | status
#
# With gpu-light installed, start claims the GPU light as hal-serve and waits for background
# GPU jobs to leave before any model loads; stop releases it (see packages/hal-core/src/halcore/gpulight.py).
# Every mode claims, cpu included: it still uses about 3GB of VRAM for prompt processing.
set -euo pipefail

HAL_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# the presets ship inside the hal-gateway package; @HAL@ in them is this directory's parent
GATEWAY_PKG="$HAL_ROOT/packages/hal-gateway/src/halgateway"
MODES_DIR="$GATEWAY_PKG/modes"
CONF_FILE="${HAL_CONF:-$HAL_ROOT/hal.conf}"
if [ -f "$CONF_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONF_FILE"
fi

LLAMA_SERVER="${HAL_LLAMA_SERVER:-}"
MODELS_DIR="${HAL_MODELS_DIR:-}"
LLAMA_URL="${HAL_LLAMA_URL:-http://127.0.0.1:8080}"
OLLAMA_URL="${HAL_OLLAMA_URL:-http://localhost:11434}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hal"
PID_FILE="$STATE_DIR/router.pid"
MODE_FILE="$STATE_DIR/router.mode"
LOG_FILE="$STATE_DIR/router.log"
ROUTE_PID_FILE="$STATE_DIR/route.pid"
ROUTE_LOG_FILE="$STATE_DIR/route.log"
ROUTE_URL="${HAL_ROUTE_URL:-http://127.0.0.1:8079}"
# Loading 50GB from a cold disk takes a few minutes
LOAD_TIMEOUT=900  # seconds
# How long start waits for background GPU jobs to leave. gpu-light gives them 30 s; the rest
# covers a job that stops late, since a mode needs nearly all the VRAM to load at full speed
LIGHT_WAIT=120  # seconds

PORT="${LLAMA_URL##*:}"
PORT="${PORT%%/*}"

die() { echo "hal-serve: $*" >&2; exit 1; }

# Runs Hal's gpu-light hook. It does nothing without gpu-light, bounds every call with its own
# timeout and always exits 0, so the light can delay the router but never stop it.
gpu_light() {
  PYTHONPATH="$HAL_ROOT/packages/hal-core/src:$HAL_ROOT/packages/hal-hub/src:$HAL_ROOT/packages/hal-kit/src${PYTHONPATH:+:$PYTHONPATH}" \
    timeout "$((LIGHT_WAIT + 30))" python3 -m halcore gpulight "$@" || true
}

router_pid() {
  local pid
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE")"
  kill -0 "$pid" 2>/dev/null || return 1
  echo "$pid"
}

# Prints the preset names (INI section headers other than [*]) of a rendered mode file
preset_names() {
  sed -n 's/^\[\([^]*][^]]*\)\]$/\1/p' "$1"
}

# Prints the presets that load when the router starts: all but those set to load on demand
startup_presets() {
  awk '/^\[/ { if (name != "" && load) print name; name = ($0 == "[*]") ? "" : substr($0, 2, length($0) - 2); load = 1 }
    /^load-on-startup *= *false/ { load = 0 }
    END { if (name != "" && load) print name }' "$1"
}

# Prints the router's status value for one model ("loaded" when ready), "missing" if the
# router doesn't know it, or "starting" while the router itself isn't answering yet
model_status() {
  local listing
  listing="$(curl -fsS "$LLAMA_URL/models" 2>/dev/null)" || { echo "starting"; return 0; }
  printf '%s' "$listing" | python3 -c '
import json, sys
name = sys.argv[1]
for m in json.load(sys.stdin).get("data", []):
    if m.get("id") == name:
        print(m.get("status", {}).get("value", "unknown"))
        break
else:
    print("missing")
' "$1"
}

# Unloads any Ollama models still holding VRAM, which would starve a llama.cpp mode
free_ollama_vram() {
  local names
  names="$(curl -fsS "$OLLAMA_URL/api/ps" 2>/dev/null | python3 -c '
import json, sys
for m in json.load(sys.stdin).get("models", []):
    if m.get("size_vram", 0) > 0:
        print(m["name"])
' 2>/dev/null)" || return 0
  for name in $names; do
    echo "Unloading Ollama model $name to free VRAM"
    curl -fsS "$OLLAMA_URL/api/generate" -d "{\"model\": \"$name\", \"keep_alive\": 0}" \
      >/dev/null 2>&1 || true
  done
}

stop_router() {
  local pid
  if [ -f "$ROUTE_PID_FILE" ]; then
    kill "$(cat "$ROUTE_PID_FILE")" 2>/dev/null || true
    rm -f "$ROUTE_PID_FILE"
  fi
  if pid="$(router_pid)"; then
    kill "$pid"
    # The router stops its model instances before it exits
    for _ in $(seq 60); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 1
    done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
  fi
  rm -f "$PID_FILE" "$MODE_FILE"
}

start_router() {
  local mode="$1" template rendered name status waited seen_loading pid
  template="$MODES_DIR/$mode.ini"
  [ -f "$template" ] || die "unknown mode '$mode' (see the files in $MODES_DIR)"
  [ -n "$LLAMA_SERVER" ] && [ -x "$LLAMA_SERVER" ] \
    || die "llama-server not found; run ./setup.sh --profile max"
  [ -n "$MODELS_DIR" ] && [ -d "$MODELS_DIR" ] \
    || die "models directory '$MODELS_DIR' not found; is the drive mounted?"

  if pid="$(router_pid)" && [ "$(cat "$MODE_FILE" 2>/dev/null)" = "$mode" ]; then
    echo "Router already serving mode $mode (pid $pid)"
    # It already holds its VRAM; this only makes sure the claim exists and follows it
    gpu_light claim hal-serve --reason "llama.cpp router $mode" --pid "$pid" --no-wait
  else
    stop_router
    gpu_light claim hal-serve --reason "llama.cpp router $mode" --timeout "$LIGHT_WAIT"
    free_ollama_vram
    mkdir -p "$STATE_DIR"
    mkdir -p "$STATE_DIR/slots"
    rendered="$STATE_DIR/$mode.ini"
    # the [hal] block (up to [*]) configures the gateway, not llama-server, so it is dropped here
    sed -e '/^\[hal\]$/,/^\[\*\]$/{/^\[\*\]$/!d}' -e "s|@MODELS@|$MODELS_DIR|g" -e "s|@HAL@|$GATEWAY_PKG|g" -e "s|@STATE@|$STATE_DIR|g" \
      "$template" > "$rendered"
    # The swap modes hold one model at a time, and only hal-route.py may load the other
    router_args=(--models-max 3)
    case "$mode" in
      orchestrate*) router_args=(--models-max 1 --no-models-autoload) ;;
    esac
    echo "Starting llama.cpp router for mode $mode on port $PORT (log: $LOG_FILE)"
    nohup "$LLAMA_SERVER" --host 127.0.0.1 --port "$PORT" \
      --models-preset "$rendered" "${router_args[@]}" > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    echo "$mode" > "$MODE_FILE"
    # Bound to the router from here on, so a router that crashes stops holding the light.
    # It replaces the boot claim of the same name; if gpu-light refuses, that one stays.
    gpu_light claim hal-serve --reason "llama.cpp router $mode" --pid "$(cat "$PID_FILE")" --no-wait
  fi

  rendered="$STATE_DIR/$mode.ini"
  for name in $(startup_presets "$rendered"); do
    waited=0
    seen_loading=0
    printf 'Loading %s ' "$name"
    while :; do
      router_pid >/dev/null || { echo; die "router exited; see $LOG_FILE"; }
      status="$(model_status "$name")"
      [ "$status" = "loaded" ] && break
      [ "$status" = "loading" ] && seen_loading=1
      # A model instance that exits during loading drops back to unloaded
      if [ "$status" = "failed" ] || { [ "$status" = "unloaded" ] && [ "$seen_loading" -eq 1 ]; }; then
        echo
        stop_router
        die "$name failed to load; see $LOG_FILE"
      fi
      [ "$waited" -ge "$LOAD_TIMEOUT" ] && { echo; die "$name still not loaded after ${LOAD_TIMEOUT}s"; }
      printf '.'
      sleep 3
      waited=$((waited + 3))
    done
    echo " ready"
  done

  # Modes that rewrite requests get the routing proxy in front of the router
  local route_args=()
  case "$mode" in
    combined)
      route_args=(--policy route --fast hal-agent --strong hal-orchestrator --classifier hal-router
                  --prompt "$MODES_DIR/combined-prompt.txt") ;;
    hybrid-auto*)
      route_args=(--policy effort) ;;
    orchestrate*)
      route_args=(--policy swap --fast hal-agent --strong hal-hybrid
                  --prompt "$MODES_DIR/orchestrate-prompt.txt") ;;
  esac
  if [ "${#route_args[@]}" -gt 0 ] && ! kill -0 "$(cat "$ROUTE_PID_FILE" 2>/dev/null)" 2>/dev/null; then
    nohup python3 "$HAL_ROOT/hal-route.py" --listen "${ROUTE_URL#http://}" --upstream "$LLAMA_URL" \
      "${route_args[@]}" --log "$ROUTE_LOG_FILE" > /dev/null 2>&1 &
    echo $! > "$ROUTE_PID_FILE"
    for _ in $(seq 20); do
      curl -fsS "$ROUTE_URL/health" >/dev/null 2>&1 && break
      sleep 0.5
    done
    echo "Routing turns through $ROUTE_URL (decisions: $ROUTE_LOG_FILE)"
  fi
}

case "${1:-}" in
  start)
    start_router "${2:-${HAL_MODE:-gpu}}" ;;
  stop)
    stop_router
    gpu_light release hal-serve
    echo "Router stopped" ;;
  status)
    if pid="$(router_pid)"; then
      mode="$(cat "$MODE_FILE" 2>/dev/null)"
      echo "Serving mode $mode on $LLAMA_URL (pid $pid)"
      for name in $(preset_names "$STATE_DIR/$mode.ini"); do
        echo "  $name: $(model_status "$name")"
      done
    else
      echo "Router not running"
    fi ;;
  *)
    sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'
    exit 1 ;;
esac
