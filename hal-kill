#!/usr/bin/env bash
# Stops everything Hal: every service and timer, the model server and anything started by
# hand. `hal off` leaves the reminder daemons running; this stops them too.
#
#   hal-kill [--quiet]     --quiet: no desktop notification
#
# Hal is left marked off, so `hal on` (or the Hal on/off launcher) starts it all again.
# The reminder daemons also come back at the next login, as they do after `hal off`.
set -uo pipefail

HAL_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
QUIET=0
[ "${1:-}" = "--quiet" ] && QUIET=1

# Hal's Python daemons and commands, whoever started them
STRAY='python[0-9.]* -m hal[a-z]+'

active_units() {
  systemctl --user list-units --state=active --plain --no-legend 'hal-*.service' 'hal-*.timer' \
    | awk '{print $1}'
}

before="$(active_units | wc -l)"

# Marks Hal off, stops the GPU services and unloads the models Ollama holds
"$HAL_ROOT/hal" off --quiet >/dev/null 2>&1 || true

# The rest of hal.target, and any briefing or reminder run a timer had already started
systemctl --user stop hal.target 'hal-*.service' 'hal-*.timer'

# max profile: the llama.cpp router behind `hal here` and `hal serve`
"$HAL_ROOT/hal-serve" stop >/dev/null 2>&1 || true

# Anything left was started outside systemd, such as `hal chat` in a terminal
if pkill -u "$UID" -f "$STRAY"; then
  for _ in $(seq 10); do
    pgrep -u "$UID" -f "$STRAY" >/dev/null || break
    sleep 0.5
  done
  pkill -9 -u "$UID" -f "$STRAY" || true
fi

left="$({ active_units; pgrep -u "$UID" -af "$STRAY"; } | paste -sd ',' | sed 's/,/, /g')"
if [ -n "$left" ]; then
  title="Hal is still running"
  msg="Could not stop: $left"
  status=1
else
  title="Hal is stopped"
  msg="Stopped $before services and timers and freed the GPU. Hal on/off starts them again."
  status=0
fi

echo "$msg"
[ "$QUIET" = 1 ] || notify-send -a Hal -i process-stop "$title" "$msg" >/dev/null 2>&1 || true
exit "$status"
