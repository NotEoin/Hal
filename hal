#!/usr/bin/env bash
#
# hal — your local AI: talk to it, code with it, and add extensions.
#
#   hal chat [message]   talk to Hal in the terminal (uses installed extensions' tools)
#   hal                  open Claude Code on the local model, in your vault
#   hal code [DIR]       private coding agent in a docker box (--build makes the image)
#   hal code accept|export|reject SID   take or discard what the agent changed in its isolated copy
#   hal scratch clean [DIR]            empty the /scratch pad of one project or all
#   hal claude [args...] Claude Code in the current directory (NOT private, not boxed)
#   hal here [args...]   open Claude Code in the current directory (for coding projects)
#   hal on | off         start Hal's services, or stop the ones using the GPU and free it
#   hal toggle           on if off, off if on (the desktop launcher runs this)
#   hal doctor           lockdown, runtime and classifier checks (exit 1 on a problem)
#   hal status           what is running, and on the max profile what the model server serves
#   hal ext [list|add|remove|enable|disable|update|doctor]   manage extensions
#   hal console          the test console: try Hal and grade answers, http://127.0.0.1:8740
#   hal eval [--model M] check Hal's answers against eval/scenarios.toml, in a sandbox
#   hal install          render and start every module's services and launchers
#   hal model NAME       use a different Ollama model for this launch
#   hal mode NAME [here] max profile: gpu | gpu-112k | cpu | hybrid | hybrid-256k |
#                        hybrid-auto | hybrid-auto-256k | combined | orchestrate |
#                        orchestrate-256k
#   hal serve [MODE]     max profile: start the model server without Claude Code
#   hal stop             max profile: stop the model server
#   hal ask|index|brief|summarize|import|obsidian-key   vault commands, from the memory extension
#   hal help             show this help
#
set -uo pipefail

# Resolve real location even when called through the ~/.local/bin/hal symlink
HAL_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
HALCORE_SRC="$HAL_ROOT/packages/hal-core/src:$HAL_ROOT/packages/hal-hub/src:$HAL_ROOT/packages/hal-kit/src:$HAL_ROOT/packages/hal-sandbox/src"
# The workspace venv (uv sync) has the MCP SDK that the hub broker needs; fall back to python3
HAL_PYTHON="$HAL_ROOT/.venv/bin/python"; [ -x "$HAL_PYTHON" ] || HAL_PYTHON=python3
halcore() { PYTHONPATH="$HALCORE_SRC${PYTHONPATH:+:$PYTHONPATH}" exec "$HAL_PYTHON" -m halcore "$@"; }

# ---- Commands that need neither hal.conf nor Claude Code --------------------
case "${1:-}" in
  chat|console|eval|ext|units|configure|code|scratch) halcore "$@" ;;
  on|off|toggle) halcore power "$@" ;;
  install) shift; halcore units install --start "$@" ;;
  ask|index|brief|summarize|import|obsidian-key|register-repos)
    # The vault lives in the memory extension.
    MEMORY="$(command -v hal-memory || true)"
    for candidate in "$HAL_ROOT/../../extensions/hal-memory/bin/hal-memory" \
                     "${HAL_EXTENSIONS:-$HOME/.local/share/hal/extensions}/hal-memory/bin/hal-memory"; do
      [ -z "$MEMORY" ] && [ -x "$candidate" ] && MEMORY="$candidate"
    done
    if [ -z "$MEMORY" ]; then
      echo "'hal $1' comes from the memory extension. Add it with:  hal ext add memory"
      exit 1
    fi
    exec "$MEMORY" "$@" ;;
esac

# The vault: HAL_VAULT, else [hal].vault in ~/.config/hal/config.toml, else ./Vault
if [ -z "${HAL_VAULT:-}" ]; then
  HAL_VAULT="$(python3 -c 'import os,tomllib;p=os.path.expanduser(os.environ.get("HAL_CONFIG","~/.config/hal/config.toml"));print(os.path.expanduser(tomllib.load(open(p,"rb")).get("hal",{}).get("vault","")))' 2>/dev/null || true)"
fi
VAULT="${HAL_VAULT:-$HAL_ROOT/Vault}"

# ---- Setup profile ----------------------------------------------------------
# hal.conf is written by ./setup.sh and records which brain this install uses:
#   24gb / 12gb  -> a local Ollama model (HAL_MODEL is set)
#   cloud        -> plain Claude Code with your own login (HAL_MODEL is empty)
# Anything already exported in your shell wins, so you can override per-launch.
CONF_FILE="${HAL_CONF:-$HAL_ROOT/hal.conf}"
if [ -f "$CONF_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONF_FILE"
fi
if [ -z "${HAL_PROFILE:-}" ]; then
  echo "No hal.conf found at $CONF_FILE — run ./setup.sh first (it picks a profile)."
  exit 1
fi

# ---- Local-model wiring (Ollama's Anthropic-compatible endpoint) ------------
MODEL="${HAL_MODEL:-}"
FAST_MODEL="${HAL_FAST_MODEL:-}"
EMBED_MODEL="${HAL_EMBED_MODEL:-nomic-embed-text}"
OLLAMA_URL="${HAL_OLLAMA_URL:-http://localhost:11434}"
ANSWERER="${HAL_ANSWERER:-ollama}"
# The max profile serves models through a llama.cpp router instead of Ollama
BACKEND="${HAL_BACKEND:-ollama}"
SERVE_MODE="${HAL_MODE:-gpu}"
LLAMA_URL="${HAL_LLAMA_URL:-http://127.0.0.1:8080}"
# Names the root note of the study hierarchy (see hal.conf).
UNIVERSITY="${HAL_UNIVERSITY:-University}"
# Max tokens Claude Code may generate per reply. The model's whole context window is 32K
# (NUM_CTX in setup.sh), and input + output share it — so this MUST stay well below 32K to
# leave room for your prompt, files and tool output. 8K is plenty per turn and also stops the
# local model from running away into a loop. To truly allow longer single replies you must
# raise NUM_CTX in setup.sh and rebuild the model (costs VRAM). Override: HAL_MAX_OUTPUT_TOKENS.
MAX_OUTPUT_TOKENS="${HAL_MAX_OUTPUT_TOKENS:-8192}"
# Permission mode for local models. Auto mode asks the model itself to approve each shell
# command, with a ~36K-token prompt and a 60 s limit; prefill on the RAM-backed modes takes
# about 2 minutes, so every check times out and the command is denied. Auto mode also drops
# allow rules such as Bash(python3:*). A --permission-mode on the command line still wins.
PERMISSION_MODE="${HAL_PERMISSION_MODE:-acceptEdits}"

usage() { sed -n '3,21p' "$(readlink -f "$0")" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  help|-h|--help)
    usage; exit 0 ;;
  model)
    MODEL="${2:-$MODEL}"; shift 2 || true
    TARGET="$VAULT" ;;
  mode)
    SERVE_MODE="${2:-$SERVE_MODE}"; shift 2 || true
    if [ "${1:-}" = "here" ]; then
      shift; TARGET="$PWD"
    else
      TARGET="$VAULT"
    fi ;;
  serve)
    exec "$HAL_ROOT/hal-serve" start "${2:-$SERVE_MODE}" ;;
  stop)
    exec "$HAL_ROOT/hal-serve" stop ;;
  status)
    PYTHONPATH="$HALCORE_SRC" python3 -m halcore power status
    PYTHONPATH="$HALCORE_SRC" python3 -m halcore security status
    [ "$BACKEND" = "llamacpp" ] && exec "$HAL_ROOT/hal-serve" status
    exit 0 ;;
  doctor)
    PYTHONPATH="$HALCORE_SRC" exec python3 -m halcore security doctor ;;
  here)
    shift; TARGET="$PWD" ;;
  claude)
    echo "hal claude: Claude Code is not private or sandboxed; use hal code for that." >&2
    shift; TARGET="$PWD" ;;
  *)
    TARGET="$VAULT" ;;
esac

# ---- Export the env Claude Code and the Python tools need -------------------
if [ "$BACKEND" = "llamacpp" ]; then
  # Names match the preset sections in modes/<mode>.ini. In combined mode the slow CPU
  # model orchestrates and every subagent runs on the fast GPU model.
  case "$SERVE_MODE" in
    gpu|gpu-112k)
              MODEL="hal-gpu";          AGENT_MODEL="hal-gpu" ;;
    cpu)      MODEL="hal-cpu";          AGENT_MODEL="hal-cpu" ;;
    hybrid|hybrid-256k|hybrid-auto|hybrid-auto-256k)
              MODEL="hal-hybrid";       AGENT_MODEL="hal-hybrid" ;;
    orchestrate|orchestrate-256k)
              MODEL="hal-hybrid";       AGENT_MODEL="hal-agent" ;;
    combined) MODEL="hal-orchestrator"; AGENT_MODEL="hal-agent" ;;
    *) echo "Unknown mode '$SERVE_MODE' (expected gpu, gpu-112k, cpu, hybrid, hybrid-256k, hybrid-auto,"
       echo "hybrid-auto-256k, combined, orchestrate or orchestrate-256k)."
       exit 1 ;;
  esac
  export ANTHROPIC_BASE_URL="$LLAMA_URL"
  # hal-route.py rewrites the requests of these modes; see MODES.md
  case "$SERVE_MODE" in
    combined|hybrid-auto*|orchestrate*)
      export ANTHROPIC_BASE_URL="${HAL_ROUTE_URL:-http://127.0.0.1:8079}" ;;
  esac
  # In the swap modes a request can wait for subagents to finish and for a model swap
  case "$SERVE_MODE" in
    orchestrate*) export API_TIMEOUT_MS="${API_TIMEOUT_MS:-7200000}" ;;
  esac
  export ANTHROPIC_AUTH_TOKEN="hal"
  export ANTHROPIC_API_KEY="hal"
  export ANTHROPIC_MODEL="$MODEL"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL"
  export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="$AGENT_MODEL"
  export ANTHROPIC_SMALL_FAST_MODEL="$AGENT_MODEL"
  export CLAUDE_CODE_SUBAGENT_MODEL="$AGENT_MODEL"
  export CLAUDE_CODE_MAX_OUTPUT_TOKENS="$MAX_OUTPUT_TOKENS"
  # Claude Code assumes 200K for a model it doesn't know, and would compact too late.
  # The smallest window in the mode applies, since subagents share the setting; the
  # decision model never sees a conversation, so its window doesn't count.
  # In the swap modes subagents start from a fresh context, so the orchestrator's applies.
  SKIP_AGENT=0
  case "$SERVE_MODE" in orchestrate*) SKIP_AGENT=1 ;; esac
  CONTEXT_TOKENS="$(awk -v skip_agent="$SKIP_AGENT" '/^\[/ {
    skip = ($0 == "[hal-router]") || (skip_agent && $0 == "[hal-agent]") }
    !skip && /^ctx-size *=/ { print $3 }' "$HAL_ROOT/modes/$SERVE_MODE.ini" | sort -n | head -n1)"
  export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CONTEXT_TOKENS:-32768}"
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"
  export DISABLE_TELEMETRY="1"
  export DISABLE_ERROR_REPORTING="1"
  export DISABLE_AUTOUPDATER="1"
  # The Python tools write with the faster model of the pair
  export HAL_MODEL="$AGENT_MODEL"
  export HAL_CHAT_API="openai"
  export HAL_CHAT_URL="$LLAMA_URL"
  # Only hal-route.py may change which model is loaded in the swap modes
  case "$SERVE_MODE" in orchestrate*) export HAL_CHAT_URL="$ANTHROPIC_BASE_URL" ;; esac
elif [ -n "$MODEL" ]; then
  # Local profiles: redirect Claude Code at Ollama's Anthropic-compatible endpoint.
  export ANTHROPIC_BASE_URL="$OLLAMA_URL"
  export ANTHROPIC_AUTH_TOKEN="ollama"
  export ANTHROPIC_API_KEY="ollama"
  export ANTHROPIC_MODEL="$MODEL"
  export HAL_MODEL="$MODEL"
  export ANTHROPIC_SMALL_FAST_MODEL="$FAST_MODEL"
  export CLAUDE_CODE_MAX_OUTPUT_TOKENS="$MAX_OUTPUT_TOKENS"
  # Fully local — no telemetry / auto-update / error reporting
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"
  export DISABLE_TELEMETRY="1"
  export DISABLE_ERROR_REPORTING="1"
  export DISABLE_AUTOUPDATER="1"
else
  # Cloud profile: touch NOTHING Anthropic-related. Claude Code uses its own login, and
  # if you've pointed it at a proxy or gateway yourself, that keeps working.
  export HAL_MODEL=""
fi
# Always exported: these drive the local RAG tools in every profile.
export HAL_VAULT="$VAULT"
export HAL_ROOT="$HAL_ROOT"
export HAL_EMBED_MODEL="$EMBED_MODEL"
export HAL_OLLAMA_URL="$OLLAMA_URL"
export HAL_ANSWERER="$ANSWERER"
export HAL_UNIVERSITY="$UNIVERSITY"

# Load the Obsidian key (used by the vault's .mcp.json as ${OBSIDIAN_API_KEY})
KEY_FILE="$HOME/.config/hal/obsidian_api_key"
if [ -f "$KEY_FILE" ]; then
  export OBSIDIAN_API_KEY="$(cat "$KEY_FILE")"
fi

# ---- Preflight: start the llama.cpp router for this mode --------------------
if [ "$BACKEND" = "llamacpp" ]; then
  "$HAL_ROOT/hal-serve" start "$SERVE_MODE" || exit 1
elif [ -n "$MODEL" ] && ! curl -fsS "$OLLAMA_URL/api/version" >/dev/null 2>&1; then
  echo "Ollama isn't responding on $OLLAMA_URL."
  echo "Start it with:  ollama serve   (or: systemctl start ollama), then re-run hal."
  exit 1
fi
if ! command -v claude >/dev/null 2>&1; then
  echo "Claude Code isn't on your PATH. Run ./setup.sh, then open a new terminal."
  exit 1
fi

# ---- GPU light: an Ollama session holds the GPU for as long as it is open ----
# Ollama loads models on demand and drops them after a few idle minutes, so between requests
# the GPU can look free while this session still needs it. The claim is bound to this shell's
# pid, which `exec claude` keeps, so it ends with the session, even after a crash. On the max
# profile hal-serve claims for the router instead. See packages/hal-core/src/halcore/gpulight.py. The 150 s limit
# covers the 60 s wait and the unloading of models Ollama split into RAM.
if [ "$BACKEND" != "llamacpp" ] && [ -n "$MODEL" ] \
    && command -v "${HAL_GPU_LIGHT:-gpu-light}" >/dev/null 2>&1; then
  PYTHONPATH="$HALCORE_SRC${PYTHONPATH:+:$PYTHONPATH}" timeout 150 python3 -m halcore gpulight \
    claim "hal-session-$$" --pid $$ --reason "hal session on $MODEL" --timeout 60 \
    --unload-offloaded || true
fi

if [ "$BACKEND" = "llamacpp" ]; then
  echo "Hal [$HAL_PROFILE, mode $SERVE_MODE] -> model: $MODEL, agents: $AGENT_MODEL   |   dir: $TARGET"
elif [ -n "$MODEL" ]; then
  echo "Hal [$HAL_PROFILE] → model: $MODEL   |   dir: $TARGET"
else
  echo "Hal [$HAL_PROFILE] → Claude Code (your own login)   |   dir: $TARGET"
fi
cd "$TARGET" || { echo "Cannot cd to $TARGET"; exit 1; }

# ---- Privacy: with a local model, Claude Code sends nothing off this machine ---------
# Every Claude Code feature that talks to Anthropic or another service is switched off, and
# as a backstop all HTTP(S) goes to a proxy address that refuses connections, with only this
# machine exempt. Commands Claude Code runs inherit the backstop, so they can't reach the
# internet either; HAL_ALLOW_NETWORK=1 lifts it. The cloud profile is left untouched: it
# talks to Anthropic by design.
if [ -n "$MODEL" ]; then
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1 \
    DISABLE_AUTOUPDATER=1 DISABLE_UPDATES=1 DISABLE_GROWTHBOOK=1 DISABLE_BUG_COMMAND=1 \
    DISABLE_FEEDBACK_COMMAND=1 DISABLE_INSTALLATION_CHECKS=1 ENABLE_CLAUDEAI_MCP_SERVERS=false \
    CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1 CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL=1 \
    CLAUDE_CODE_DISABLE_WORKING_SYNC=1 CLAUDE_CODE_DISABLE_ARTIFACT=1 CLAUDE_CODE_DISABLE_WEB_FETCH=1 \
    CLAUDE_CODE_DISABLE_VITALS_EMITTER=1 CLAUDE_CODE_DISABLE_ORG_MEMORY=1 \
    CLAUDE_CODE_DISABLE_MEMORY_PERIODIC_RESYNC=1 CLAUDE_CODE_SKIP_REPO_UPLOAD=1 \
    CLAUDE_CODE_SKIP_FAST_MODE_ORG_CHECK=1 CLAUDE_CODE_DISABLE_FAST_MODE=1
  if [ "${HAL_ALLOW_NETWORK:-0}" != "1" ]; then
    for var in HTTPS_PROXY HTTP_PROXY ALL_PROXY https_proxy http_proxy all_proxy; do
      export "$var=http://127.0.0.1:9"
    done
    export NO_PROXY="localhost,127.0.0.1,::1" no_proxy="localhost,127.0.0.1,::1"
  fi
fi

if [ -n "$MODEL" ]; then
  case " $* " in
    *" --permission-mode"*|*" --dangerously-skip-permissions "*) ;;
    *) set -- --permission-mode "$PERMISSION_MODE" "$@" ;;
  esac
fi
exec claude "$@"
