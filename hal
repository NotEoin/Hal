#!/usr/bin/env bash
#
# hal — launch Claude Code against your local model, or the cloud. See hal.conf.
#
#   hal                  open Claude Code in your vault (your "second brain")
#   hal here [args...]   open in the current directory (for coding projects)
#   hal summarize [opts] grind through outstanding slide summaries, unattended
#   hal brief [opts]     write today's local morning brief into your daily note
#   hal index [opts]     (re)build the local semantic index of your vault
#   hal ask "question"   answer a question grounded in your own notes (cited)
#   hal obsidian-key K   save your Obsidian Local REST API key (one time)
#   hal model NAME       use a different Ollama model for this launch
#   hal help             show this help
#
set -uo pipefail

# Resolve real location even when called through the ~/.local/bin/hal symlink
HAL_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
VAULT="${HAL_VAULT:-$HAL_ROOT/Vault}"
KEY_FILE="$HOME/.config/hal/obsidian_api_key"

# ---- Setup profile ----------------------------------------------------------
# hal.conf is written by ./setup.sh and records which brain this install uses:
#   24gb / 12gb  -> a local Ollama model (HAL_MODEL is set)
#   cloud        -> plain Claude Code with your own login (HAL_MODEL is empty)
# Anything already exported in your shell wins, so you can override per-launch.
CONF_FILE="${HAL_CONF:-$HAL_ROOT/hal.conf}"
if [ -f "$CONF_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONF_FILE"
fi
if [ -z "${HAL_PROFILE:-}" ]; then
  echo "No hal.conf found at $CONF_FILE — run ./setup.sh first (it picks a profile)."
  exit 1
fi

# ---- Local-model wiring (Ollama's Anthropic-compatible endpoint) ------------
MODEL="${HAL_MODEL:-}"
FAST_MODEL="${HAL_FAST_MODEL:-}"
EMBED_MODEL="${HAL_EMBED_MODEL:-nomic-embed-text}"
OLLAMA_URL="${HAL_OLLAMA_URL:-http://localhost:11434}"
ANSWERER="${HAL_ANSWERER:-ollama}"
# Names the root note of the study hierarchy (see hal.conf).
UNIVERSITY="${HAL_UNIVERSITY:-University}"
# Max tokens Claude Code may generate per reply. The model's whole context window is 32K
# (NUM_CTX in setup.sh), and input + output share it — so this MUST stay well below 32K to
# leave room for your prompt, files and tool output. 8K is plenty per turn and also stops the
# local model from running away into a loop. To truly allow longer single replies you must
# raise NUM_CTX in setup.sh and rebuild the model (costs VRAM). Override: HAL_MAX_OUTPUT_TOKENS.
MAX_OUTPUT_TOKENS="${HAL_MAX_OUTPUT_TOKENS:-8192}"

usage() { sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'; }

MODE="claude"
case "${1:-}" in
  help|-h|--help)
    usage; exit 0 ;;
  obsidian-key)
    KEY="${2:-}"
    if [ -z "$KEY" ]; then echo "Usage: hal obsidian-key <API_KEY>"; exit 1; fi
    mkdir -p "$(dirname "$KEY_FILE")"
    printf '%s' "$KEY" > "$KEY_FILE"
    chmod 600 "$KEY_FILE"
    echo "Saved Obsidian API key. Hal can now talk to your running Obsidian app."
    exit 0 ;;
  summarize)
    MODE="summarize"; shift
    TARGET="$VAULT" ;;
  brief)
    MODE="brief"; shift
    TARGET="$VAULT" ;;
  index)
    MODE="index"; shift
    TARGET="$VAULT" ;;
  ask)
    MODE="ask"; shift
    TARGET="$VAULT" ;;
  model)
    MODEL="${2:-$MODEL}"; shift 2 || true
    TARGET="$VAULT" ;;
  here)
    shift; TARGET="$PWD" ;;
  *)
    TARGET="$VAULT" ;;
esac

# ---- Export the env Claude Code and the Python tools need -------------------
if [ -n "$MODEL" ]; then
  # Local profiles: redirect Claude Code at Ollama's Anthropic-compatible endpoint.
  export ANTHROPIC_BASE_URL="$OLLAMA_URL"
  export ANTHROPIC_AUTH_TOKEN="ollama"
  export ANTHROPIC_API_KEY="ollama"
  export ANTHROPIC_MODEL="$MODEL"
  export HAL_MODEL="$MODEL"
  export ANTHROPIC_SMALL_FAST_MODEL="$FAST_MODEL"
  export CLAUDE_CODE_MAX_OUTPUT_TOKENS="$MAX_OUTPUT_TOKENS"
  # Fully local — no telemetry / auto-update / error reporting
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"
  export DISABLE_TELEMETRY="1"
  export DISABLE_ERROR_REPORTING="1"
  export DISABLE_AUTOUPDATER="1"
else
  # Cloud profile: touch NOTHING Anthropic-related. Claude Code uses its own login, and
  # if you've pointed it at a proxy or gateway yourself, that keeps working.
  export HAL_MODEL=""
fi
# Always exported: these drive the local RAG tools in every profile.
export HAL_VAULT="$VAULT"
export HAL_ROOT="$HAL_ROOT"
export HAL_EMBED_MODEL="$EMBED_MODEL"
export HAL_OLLAMA_URL="$OLLAMA_URL"
export HAL_ANSWERER="$ANSWERER"
export HAL_UNIVERSITY="$UNIVERSITY"

# Load the Obsidian key (used by .mcp.json's ${OBSIDIAN_API_KEY})
if [ -f "$KEY_FILE" ]; then
  export OBSIDIAN_API_KEY="$(cat "$KEY_FILE")"
fi

# ---- Preflight: is Ollama up? -----------------------------------------------
# Needed for the local model (24gb/12gb) AND for embeddings in every profile, so the
# index/ask commands still want it even on cloud.
if ! curl -fsS "$OLLAMA_URL/api/version" >/dev/null 2>&1; then
  case "$MODE" in
    brief) echo "Note: Ollama isn't up — the brief will fall back to its plain (no-LLM) format." ;;
    index|ask) echo "Note: Ollama isn't up — embeddings are unavailable, so only --mock (index) / --mock|--no-llm (ask) will work." ;;
    *)
      if [ -n "$MODEL" ]; then
        echo "Ollama isn't responding on $OLLAMA_URL."
        echo "Start it with:  ollama serve   (or: systemctl start ollama), then re-run hal."
        exit 1
      fi
      # Cloud profile: Claude Code doesn't need Ollama at all. Only 'hal ask' does.
      echo "Note: Ollama isn't up — 'hal ask' and 'hal index' won't work until it is." ;;
  esac
fi
case "$MODE" in
  summarize|brief|index|ask) : ;;   # these don't need Claude Code on PATH
  *)
    if ! command -v claude >/dev/null 2>&1; then
      echo "Claude Code isn't on your PATH. Run ./setup.sh, then open a new terminal."
      exit 1
    fi ;;
esac

# Unattended slide-summary runner (talks to you as Hal, resumes itself).
if [ "$MODE" = "summarize" ]; then
  cd "$TARGET" || { echo "Cannot cd to $TARGET"; exit 1; }
  exec python3 -u "$HAL_ROOT/summarize-all.py" "$@"
fi

# Local morning brief — assembles your day and writes it into today's daily note.
if [ "$MODE" = "brief" ]; then
  cd "$TARGET" || { echo "Cannot cd to $TARGET"; exit 1; }
  exec python3 -u "$HAL_ROOT/morning-brief.py" "$@"
fi

# (Re)build the local semantic index of the vault (incremental; nothing leaves the machine).
if [ "$MODE" = "index" ]; then
  exec python3 -u "$HAL_ROOT/vault-index.py" --vault "$VAULT" "$@"
fi

# Ask a question, answered ONLY from your own notes, with [[wikilink]] citations.
if [ "$MODE" = "ask" ]; then
  exec python3 -u "$HAL_ROOT/ask.py" --vault "$VAULT" "$@"
fi

if [ -n "$MODEL" ]; then
  echo "Hal [$HAL_PROFILE] → model: $MODEL   |   dir: $TARGET"
else
  echo "Hal [$HAL_PROFILE] → Claude Code (your own login)   |   dir: $TARGET"
fi
cd "$TARGET" || { echo "Cannot cd to $TARGET"; exit 1; }
exec claude "$@"
