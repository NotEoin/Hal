 """A tiny CSV writer."""
 
 
+def _quote(field):
+    text = str(field)
+    if any(c in text for c in ',"\n\r'):
+        return '"' + text.replace('"', '""') + '"'
+    return text
+
+
 def write_row(fields):
     """Returns one CSV line (without the newline) for the list of fields."""
-    return ",".join(str(f) for f in fields)
+    return ",".join(_quote(f) for f in fields)
