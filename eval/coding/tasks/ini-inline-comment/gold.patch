 """Parses key = value lines."""
 
+import re
+
+_INLINE_COMMENT = re.compile(r"\s+[;#].*$")
+
 
 def parse(text):
-    """Returns a dict of the key = value lines."""
+    """Returns a dict of the key = value lines; an inline comment after whitespace is dropped."""
     result = {}
     for line in text.splitlines():
         line = line.strip()
         if not line or line[0] in ";#":
             continue
         key, _, value = line.partition("=")
-        result[key.strip()] = value.strip()
+        result[key.strip()] = _INLINE_COMMENT.sub("", value.strip())
     return result
